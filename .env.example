PROJECT_NAME="NutriAI API"
API_TOKEN="nutri_dev_secret_token_123"
ENVIRONMENT="development"
JWT_SECRET="cambia_esto_por_una_clave_larga_y_aleatoria"

# Copias de seguridad diarias de nutri_ai.db
BACKUP_AUTO="1"                # 0 desactiva la copia automática al arrancar el servidor
BACKUP_DIR="backups"           # puede ser una carpeta sincronizada con OneDrive / Google Drive / Dropbox
BACKUP_RETENTION_DAYS="14"

# Solo para desarrollo/tests: permite llamar a la API sin token usando el primer usuario
AUTH_DEMO_FALLBACK="0"

# Google Sheets (opcional): URL /exec del Apps Script de docs/google_sheets_apps_script.gs
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Hora local (HH:MM) para cerrar la jornada y enviar el resumen automáticamente
GOOGLE_SHEETS_HORA_CIERRE=23:55
# Inicio de sesión con Google: el "ID de cliente" de Google Cloud Console (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=""
